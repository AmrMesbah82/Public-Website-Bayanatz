{
  "flutter": {
    "platforms": {
      "ios": {
        "default": {
          "projectId": "web-app-admin-33b9a",
          "appId": "1:410427123296:ios:1b3f1621ef06a6eb384505",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "web-app-admin-33b9a",
          "appId": "1:410427123296:ios:1b3f1621ef06a6eb384505",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "web-app-admin-33b9a",
          "configurations": {
            "ios": "1:410427123296:ios:1b3f1621ef06a6eb384505",
            "macos": "1:410427123296:ios:1b3f1621ef06a6eb384505",
            "web": "1:410427123296:web:014d9fc3f258dc21384505",
            "windows": "1:410427123296:web:2ffa8600a3455bb4384505"
          }
        }
      }
    }
  },
  "hosting": {
    "target": "admin",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/index.html"
      },
      {
        "source": "/services",
        "destination": "/index.html"
      },
      {
        "source": "/about",
        "destination": "/index.html"
      },
      {
        "source": "/contact",
        "destination": "/index.html"
      },
      {
        "source": "/careers",
        "destination": "/index.html"
      },
      {
        "source": "/jobs",
        "destination": "/index.html"
      },
      {
        "source": "/jobs/**",
        "destination": "/index.html"
      },
      {
        "source": "/blog/**",
        "destination": "/index.html"
      },
      {
        "source": "/contact-us",
        "destination": "/index.html"
      },
      {
        "source": "/about-us",
        "destination": "/index.html"
      },
      {
        "source": "/career",
        "destination": "/index.html"
      },
      {
        "source": "/home",
        "destination": "/index.html"
      },
      {
        "source": "/service",
        "destination": "/index.html"
      },
      {
        "source": "/services/",
        "destination": "/index.html"
      },
      {
        "source": "/about/",
        "destination": "/index.html"
      },
      {
        "source": "/contact/",
        "destination": "/index.html"
      },
      {
        "source": "/careers/",
        "destination": "/index.html"
      },
      {
        "source": "/jobs/",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(ttf|otf|png|svg|jpg|jpeg|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ],
      "source": "functions"
    },
    {
      "source": "deafult",
      "codebase": "deafult",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
